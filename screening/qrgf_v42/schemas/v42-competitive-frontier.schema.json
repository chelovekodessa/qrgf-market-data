{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "architecture_version",
    "competitive_unresolved_count",
    "rows",
    "frontier_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "qrgf_v42_competitive_frontier"
    },
    "architecture_version": {
      "const": "4.2.0"
    },
    "competitive_unresolved_count": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "frontier_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
