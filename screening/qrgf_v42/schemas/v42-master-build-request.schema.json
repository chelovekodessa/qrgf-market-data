{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "architecture_version",
    "publisher_must_recompute",
    "identity_map",
    "market_index",
    "query_plan",
    "expected_candidate_source_sha256",
    "expected_master_sha256",
    "expected_selector_certificate_sha256",
    "request_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "qrgf_v42_master_core500_build_request"
    },
    "architecture_version": {
      "const": "4.2.0"
    },
    "publisher_must_recompute": {
      "const": true
    },
    "identity_map": {
      "type": "object"
    },
    "market_index": {
      "type": "object"
    },
    "query_plan": {
      "type": "object"
    },
    "expected_candidate_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_master_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_selector_certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
