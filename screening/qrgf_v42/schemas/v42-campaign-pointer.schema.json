{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "architecture_version",
    "state_path",
    "state_sha256",
    "master_sha256",
    "phase",
    "daily_broad_allowed",
    "producer_release_sha256",
    "pointer_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "qrgf_v42_campaign_pointer"
    },
    "architecture_version": {
      "const": "4.2.0"
    },
    "state_path": {
      "type": "string",
      "pattern": "^data/v42/campaigns/[0-9a-f]{64}/state\\.json$"
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "master_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "CANARY",
        "PILOT",
        "CORE500",
        "COMPLETE"
      ]
    },
    "daily_broad_allowed": {
      "type": "boolean"
    },
    "producer_release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pointer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
