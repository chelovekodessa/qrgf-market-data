{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ticker",
    "contract_id",
    "security_type",
    "events",
    "evidence",
    "analysis_time",
    "research_cutoff_at",
    "l3"
  ],
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "security_type": {
      "enum": [
        "common_equity",
        "adr",
        "etf"
      ]
    },
    "events": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "analysis_time": {
      "type": "string"
    },
    "research_cutoff_at": {
      "type": "string"
    },
    "l3": {
      "type": "object"
    },
    "analyst_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "firm": {
            "type": "string"
          },
          "bank": {
            "type": "string"
          },
          "analyst": {
            "type": "string"
          },
          "rating": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "new_target": {
            "type": [
              "number",
              "null"
            ]
          },
          "target": {
            "type": [
              "number",
              "null"
            ]
          },
          "previous_target": {
            "type": [
              "number",
              "null"
            ]
          },
          "old_target": {
            "type": [
              "number",
              "null"
            ]
          },
          "currency": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "action_date": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
