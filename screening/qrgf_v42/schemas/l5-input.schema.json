{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "ticker",
    "contract_id",
    "security_type",
    "quote",
    "technicals",
    "historical_recovery",
    "market_context",
    "l3",
    "l4",
    "evidence",
    "analysis_time",
    "research_cutoff_at"
  ],
  "properties": {
    "ticker": {
      "type": "string",
      "minLength": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "security_type": {
      "enum": [
        "common_equity",
        "adr",
        "etf"
      ]
    },
    "quote": {
      "type": "object"
    },
    "technicals": {
      "type": "object"
    },
    "historical_recovery": {
      "type": "object"
    },
    "market_context": {
      "type": "object",
      "required": [
        "market_status",
        "sector_status",
        "opportunity_score",
        "benchmarks"
      ],
      "properties": {
        "market_status": {},
        "sector_status": {},
        "opportunity_score": {
          "type": "number"
        },
        "benchmarks": {
          "type": "object",
          "required": [
            "SPY",
            "QQQ",
            "IWM",
            "VIX"
          ],
          "properties": {
            "SPY": {
              "type": "object",
              "minProperties": 1
            },
            "QQQ": {
              "type": "object",
              "minProperties": 1
            },
            "IWM": {
              "type": "object",
              "minProperties": 1
            },
            "VIX": {
              "type": "object",
              "minProperties": 1
            }
          },
          "additionalProperties": true
        },
        "sector_etf": {
          "type": "object"
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "l3": {
      "type": "object"
    },
    "l4": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "analysis_time": {
      "type": "string"
    },
    "research_cutoff_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
