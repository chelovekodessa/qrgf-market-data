{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "maxItems": 4,
  "items": {
    "type": "object",
    "required": ["ticker", "contract_id", "work_status"],
    "properties": {
      "ticker": {"type": "string", "minLength": 1},
      "contract_id": {"type": "string", "minLength": 1},
      "work_status": {"enum": ["resolved", "insufficient_data", "rejected", "retryable"]}
    },
    "additionalProperties": true
  }
}
