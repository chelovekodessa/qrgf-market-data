{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "architecture_version",
    "market_index_sha256",
    "partition_coverage_complete",
    "leaf_count",
    "receipt_count",
    "leaves",
    "receipts",
    "regression_expectations",
    "query_plan_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "qrgf_v42_metricduck_query_plan"
    },
    "architecture_version": {
      "const": "4.2.0"
    },
    "market_index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "partition_coverage_complete": {
      "const": true
    },
    "leaf_count": {
      "type": "integer",
      "minimum": 1
    },
    "receipt_count": {
      "type": "integer",
      "minimum": 1
    },
    "leaves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "regression_expectations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "query_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
